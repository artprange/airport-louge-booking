generator client {
    provider = "prisma-client"

    output = "../src/generated/prisma"

    moduleFormat = "esm"
    generatedFileExtension = "ts"
    importFileExtension = "js"
}

datasource db {
    provider = "postgresql"
}

model Lounge {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  airportCode String
  capacity    Int

  
  price       Decimal @db.Decimal(10, 2)


  bookings Booking[]


  @@index([airportCode])
}

model Booking {
  id           String   @id @default(uuid()) @db.Uuid
  loungeId     String   @db.Uuid
  customerName String
  guests       Int

  bookingDate DateTime @db.Date

  createdAt DateTime @default(now())

  lounge Lounge @relation(fields: [loungeId], references: [id], onDelete: Restrict)

  @@index([loungeId, bookingDate])
}