{
	"name": "fs-test-backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"docs:validate": "node scripts/validate-openapi.mjs",
		"db:deploy": "prisma migrate deploy",
		"pretest:db": "npm run build",
		"test:db": "node tests/database/booking-concurrency.integration.mjs",
		"lint": "eslint . --max-warnings=0",
		"pretest": "npm run build && npm run docs:validate",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
		"dev": "tsx watch src/server.ts",
		"typecheck": "tsc --noEmit",
		"build": "prisma generate && tsc",
		"start": "node dist/server.js",
		"db:validate": "prisma validate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"dotenv": "^18.0.5",
		"express": "^5.2.1",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "^13.1.0",
		"@eslint/js": "^10.0.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"@types/swagger-ui-express": "^4.1.8",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"jest": "^30.5.2",
		"prisma": "^7.10.0",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "5.9",
		"typescript-eslint": "^8.72.0"
	}
}
